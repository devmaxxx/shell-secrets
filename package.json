{
  "name": "shell-secrets",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "description": "Find live API tokens, private keys and database passwords in strings, logs, AI-agent tool calls and shell commands. Zero dependencies, in-process, typed.",
  "author": "devmaxxx",
  "license": "MIT",
  "homepage": "https://github.com/devmaxxx/shell-secrets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaxxx/shell-secrets.git"
  },
  "bugs": {
    "url": "https://github.com/devmaxxx/shell-secrets/issues"
  },
  "keywords": [
    "secrets",
    "secret-detection",
    "secret-scanning",
    "credentials",
    "api-key",
    "token",
    "leak",
    "security",
    "redact",
    "pre-commit",
    "gitleaks",
    "secretlint",
    "detect-secrets",
    "ai-agent",
    "claude-code",
    "hook",
    "shell",
    "bash",
    "scanner"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "shell-secrets": "./dist/cli.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  }
}
